#!/usr/bin/env bash
set -euo pipefail

# Block pushes that include files we never want in remote repos.
blocked_patterns=(
  'venv/'
  '.venv/'
  '__pycache__/'
  '.env'
  '.env.'
  'db.sqlite3'
  '.DS_Store'
)

# Check staged/tracked file list that would be pushed.
changed_files=$(git diff --name-only --cached)

if [[ -z "${changed_files}" ]]; then
  exit 0
fi

fail=0

while IFS= read -r file; do
  for pat in "${blocked_patterns[@]}"; do
    if [[ "$pat" == *'/' ]]; then
      if [[ "$file" == "$pat"* ]]; then
        echo "[pre-push] Blocked: $file matches forbidden path pattern '$pat'"
        fail=1
      fi
    else
      if [[ "$file" == *"$pat"* ]]; then
        echo "[pre-push] Blocked: $file matches forbidden pattern '$pat'"
        fail=1
      fi
    fi
  done

  # Prevent likely credential leaks in tracked files.
  if [[ "$file" == "apidemo/apidemo/settings.py" ]]; then
    if git diff --cached -- "$file" | grep -E "\+.*(PASSWORD\s*=\s*'[^']+'|SECRET_KEY\s*=\s*'[^']+')" >/dev/null; then
      echo "[pre-push] Blocked: $file appears to include hardcoded secrets in staged changes."
      fail=1
    fi
  fi
done <<< "$changed_files"

if [[ "$fail" -ne 0 ]]; then
  echo ""
  echo "Push blocked. Remove sensitive/unwanted files from commit, then try again."
  echo "Tip: git restore --staged <file>"
  exit 1
fi

exit 0
